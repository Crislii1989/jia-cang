# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android signing secrets (do not commit)
/android/key.properties
/android/app/*.jks
/android/app/keystore.properties

# Environment variables (contains secrets, do not commit)
.env
.env.local
.env.*.local

# WorkBuddy agent working data (memory, verify screenshots)
.workbuddy/

# IDE/tool working dirs
.codegraph/
.reasonix/
.trae/

# Agent / 调试临时输出（历次会话遗留的 build*、t*、an*、commit*、scan 等日志，一律不入库）
# ⚠️ 只锚定根目录（/*.txt），**别改成裸 `*.txt`**：
#    assets/prompts/item_recognition_prompt.txt 是 PromptService 实际加载的资产，
#    linux|windows 下的 CMakeLists.txt 是构建文件，它们都是真实文件。
/*.txt
